{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/refs": "error",
    "react/purity": "error",
    "react/set-state-in-effect": "error",
    "react/static-components": "error",
    "react/exhaustive-deps": "error",
    "no-useless-escape": "error"
  },
  "overrides": [
    {
      "files": ["src/services/pipeline/renderers/CpfUniversalCanvas.tsx"],
      "rules": { "react/refs": "warn", "react/purity": "warn", "react/exhaustive-deps": "warn" }
    },
    {
      "files": ["src/services/pipeline/renderers/FarmQuizCanvas.tsx", "src/player/room/useRoomSeconds.ts"],
      "rules": { "react/purity": "warn" }
    },
    {
      "files": ["src/games/common/ConfettiEffect.tsx"],
      "rules": { "react/refs": "warn", "react/set-state-in-effect": "warn" }
    },
    {
      "files": ["src/pages/WorkspaceEditor.tsx"],
      "rules": { "react/refs": "warn" }
    },
    {
      "files": ["src/pages/CreateGamePage.tsx"],
      "rules": { "react/set-state-in-effect": "warn", "react/exhaustive-deps": "warn" }
    },
    {
      "files": ["src/player/room/useTeacherRoom.ts"],
      "rules": { "react/set-state-in-effect": "warn" }
    },
    {
      "files": ["src/player/room/RoomStudentScreen.tsx"],
      "rules": { "react/static-components": "warn" }
    },
    {
      "files": ["src/player/renderers/AudioVisualMatchPlayable.tsx"],
      "rules": { "react/exhaustive-deps": "warn" }
    }
  ]
}
