VITE_API_BASE_URL=http://localhost:8080/api

# Dữ liệu mô phỏng theo nhóm endpoint: all, none hoặc danh sách cách nhau bởi dấu phẩy
# (games, editor, media, ai, sessions, results). Bỏ trống: bật hết khi chạy npm run dev, tắt ở bản build.
# Đăng nhập và đăng ký luôn gọi backend thật.
VITE_USE_MOCK=
# Độ trễ giả lập (mili giây) của dữ liệu mô phỏng.
VITE_MOCK_LATENCY_MS=400

# Địa chỉ gốc của TRANG HỌC SINH (nơi học sinh mở mã chia sẻ). shareUrl do Backend trả về luôn được ưu tiên; biến này chỉ là dự phòng cho dữ liệu
# mô phỏng (và khi Backend chưa trả shareUrl): liên kết chia sẻ ghép thành <địa chỉ gốc>/play/<mã chia sẻ>. Chỉ nhận http hoặc https; để trống thì
# dùng chính địa chỉ đang mở ứng dụng. Mặc định cho phát triển: cùng ứng dụng Vite.
VITE_STUDENT_APP_BASE_URL=http://localhost:5173
