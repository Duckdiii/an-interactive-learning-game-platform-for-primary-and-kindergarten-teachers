VITE_API_BASE_URL=http://localhost:8080/api

# Khu thử nghiệm: đặt 1 khi build riêng để có route /dev/experiments (bản dev luôn bật). Để trống ở bản triển khai.
# VITE_EXPERIMENTS=1

# T8.1 (script cục bộ scripts/experiments/tts-google.mjs, KHÔNG dùng ở trình duyệt, KHÔNG có tiền tố VITE_): khóa Google Cloud Text-to-Speech.
# Đặt giá trị trong frontend/.env.tts.local (đã bị .gitignore) hoặc biến môi trường; để trống ở đây.
# GOOGLE_TTS_API_KEY=

# T8.2 (script cục bộ scripts/experiments/img-openai.mjs, KHÔNG dùng ở trình duyệt, KHÔNG có tiền tố VITE_): khóa OpenAI Images (khác OPENAI_API_KEY của backend).
# Đặt giá trị trong frontend/.env.image.local (đã bị .gitignore) hoặc biến môi trường; để trống ở đây.
# OPENAI_IMAGES_API_KEY=
