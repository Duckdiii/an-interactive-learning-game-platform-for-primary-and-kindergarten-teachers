VITE_API_BASE_URL=http://localhost:8080/api

# Dữ liệu mô phỏng theo nhóm endpoint: all, none hoặc danh sách cách nhau bởi dấu phẩy
# (games, editor, media, ai, sessions, results). Bỏ trống: bật hết khi chạy npm run dev, tắt ở bản build.
# Đăng nhập và đăng ký luôn gọi backend thật.
VITE_USE_MOCK=
# Độ trễ giả lập (mili giây) của dữ liệu mô phỏng.
VITE_MOCK_LATENCY_MS=400
