#!/bin/sh
# Hook pre-commit cho mọi agent và người. Bật một lần sau khi clone: node scripts/setup-hooks.mjs
# 1. Xoay vòng ai-usage-log.md (không chặn). 2. Chặn file nhạy cảm/cấu hình nguy hiểm. 3. Quét secret bằng gitleaks.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: CHẶN vì không tìm thấy node, không chạy được kiểm tra cấu hình." >&2
  exit 1
fi

out=$(node scripts/ai-log/rotate.mjs 2>&1)
if [ $? -ne 0 ]; then
  # Chỉ cảnh báo; CI chặn nếu log quá dài.
  echo "pre-commit: không xoay vòng được ai-usage-log.md: $out" >&2
elif [ -n "$out" ]; then
  echo "$out"
  git add ai-usage-log.md docs/ai-usage-log-archive
fi

node scripts/hooks/check-config.mjs || {
  echo "pre-commit: commit bị chặn (xem các dòng [CHẶN] ở trên)." >&2
  exit 1
}

if command -v gitleaks >/dev/null 2>&1; then
  # GIT_ATTR_NOSYSTEM chỉ cho lệnh này: Git for Windows gán `*.docx diff=astextplain` ở cấp hệ thống, bộ chuyển đổi đó
  # lỗi với .docx làm `git diff` dừng giữa chừng; gitleaks chỉ ghi ERR rồi vẫn exit 0 "no leaks found" (đã quét 0 byte).
  gl_out=$(GIT_ATTR_NOSYSTEM=1 gitleaks git --pre-commit --staged --redact --no-banner --no-color 2>&1)
  gl_code=$?
  printf '%s\n' "$gl_out"
  if [ $gl_code -ne 0 ]; then
    echo "pre-commit: gitleaks phát hiện secret hoặc chạy lỗi (exit $gl_code), commit bị chặn." >&2
    exit 1
  fi
  # Fail-closed: gitleaks có thể exit 0 dù đọc diff lỗi, nên dòng log mức ERR cũng chặn. Không có --no-color thì log
  # có mã màu ANSI cả khi gom vào biến (đã đo bằng od); vẫn bỏ mã màu phòng bản gitleaks khác. ERR phải đứng ngay sau
  # giờ ("5:17PM ERR ...") để không bắt nhầm tên file.
  esc=$(printf '\033')
  if printf '%s\n' "$gl_out" | sed "s/${esc}\[[0-9;]*m//g" | grep -Eq '^[^ ]+ ERR( |$)'; then
    echo "pre-commit: gitleaks báo lỗi khi đọc phần đã stage (dòng ERR ở trên), không chắc đã quét hết nên commit bị chặn." >&2
    exit 1
  fi
else
  echo "pre-commit: CẢNH BÁO chưa cài gitleaks nên KHÔNG quét secret ở máy này (CI vẫn quét). Cài: winget install gitleaks.gitleaks" >&2
fi
exit 0
