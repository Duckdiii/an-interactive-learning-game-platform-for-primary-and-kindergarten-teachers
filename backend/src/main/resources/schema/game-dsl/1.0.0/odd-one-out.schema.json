{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game DSL v1.0.0 - ODD_ONE_OUT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameType",
    "metadata",
    "gameplaySettings",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "gameType": {
      "const": "ODD_ONE_OUT"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subject",
        "gradeLevel",
        "topic"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "enum": [
            "MATH",
            "VIETNAMESE",
            "ENGLISH"
          ]
        },
        "gradeLevel": {
          "type": "string",
          "enum": [
            "KINDERGARTEN",
            "GRADE_1",
            "GRADE_2",
            "GRADE_3",
            "GRADE_4",
            "GRADE_5"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "gameplaySettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hitboxScale"
      ],
      "properties": {
        "hitboxScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "a",
            "b",
            "c",
            "d",
            "e"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timeLimitSeconds",
        "points",
        "items",
        "oddOneOutId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[0-9]+$"
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "audioText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "audioUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "visualPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "oddOneOutId": {
          "type": "string",
          "enum": [
            "a",
            "b",
            "c",
            "d",
            "e"
          ]
        }
      }
    }
  }
}
