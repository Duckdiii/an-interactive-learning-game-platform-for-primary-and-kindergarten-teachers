{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game AI Output v1.1.0 - ODD_ONE_OUT IMAGE",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "oddOneOutIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "audioText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "questionText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "items",
          "oddOneOutIndex",
          "questionText"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
