{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game AI Output v1.0.0 - AUDIO_VISUAL_MATCH",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "presentation": {
      "type": "object",
      "properties": {
        "world": {
          "type": "string",
          "maxLength": 20
        },
        "carrier": {
          "type": "string",
          "maxLength": 20
        },
        "layout": {
          "type": "string",
          "maxLength": 20
        }
      },
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "audioText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "correct": {
            "type": "object",
            "properties": {
              "visualPrompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "asset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "visualPrompt"
            ],
            "additionalProperties": false
          },
          "distractors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "visualPrompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "asset": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "required": [
                "visualPrompt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "audioText",
          "correct",
          "distractors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
