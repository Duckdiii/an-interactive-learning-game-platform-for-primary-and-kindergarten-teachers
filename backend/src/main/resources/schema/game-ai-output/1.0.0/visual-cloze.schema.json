{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game AI Output v1.0.0 - VISUAL_CLOZE",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "sentenceTemplate": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "visualPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "correctAnswer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "distractors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "audioText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "sentenceTemplate",
          "visualPrompt",
          "correctAnswer",
          "distractors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
