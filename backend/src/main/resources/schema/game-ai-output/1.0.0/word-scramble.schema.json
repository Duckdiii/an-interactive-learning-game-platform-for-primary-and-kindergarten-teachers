{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game AI Output v1.0.0 - WORD_SCRAMBLE",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "correctWord": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "visualPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "audioText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "correctWord"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
