# Supabase PostgreSQL connection (Session Pooler or Direct Connection — NOT the Transaction Pooler / port 6543)
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USERNAME=<SUPABASE_DB_USERNAME>
DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# JWT signing key (at least 32 random characters). Generate one, never commit the real value.
JWT_SECRET=<RANDOM_STRING_AT_LEAST_32_CHARS>
# Set false only if your browser rejects Secure cookies on http://localhost.
COOKIE_SECURE=true
# Quên mật khẩu (UC-15). Trang Frontend nhận liên kết ?token=... ; bắt buộc khi chạy profile prod.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Gửi thư qua SMTP. MAIL_ENABLED=false (mặc định ở máy cá nhân): không gửi, in liên kết ra log backend.
# Profile prod luôn gửi thư thật và bắt buộc MAIL_HOST, MAIL_FROM. Không commit mật khẩu SMTP thật.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Đặt false nếu SMTP relay không yêu cầu đăng nhập.
MAIL_SMTP_AUTH=true
# Origin của trang chơi và gốc link chia sẻ gửi cho phụ huynh.
# Khi chạy profile prod (SPRING_PROFILES_ACTIVE=prod) hai biến này là bắt buộc, không có mặc định localhost.
PLAYER_ORIGIN=http://localhost:5173
# Mặc định lấy PLAYER_ORIGIN và nối /join. Chỉ đặt nếu trang tham gia nằm ở URL khác.
# LIVE_ARENA_JOIN_BASE_URL=https://play.example.edu.vn/join
PLAYER_SHARE_BASE_URL=http://localhost:5173/play
# Danh sách origin được gọi API, ngăn cách bằng dấu phẩy. Bắt buộc khi chạy profile prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Triển khai: trỏ tới volume bền vững và URL HTTPS của backend kết thúc bằng /media.
# MEDIA_STORAGE_LOCAL_DIR=/data/aigame/media
# MEDIA_STORAGE_BASE_URL=https://api.example.edu.vn/media
# OpenAI Moderation (Layer 3 kiểm duyệt an toàn). Để trống (không điền giá trị mẫu) nếu chưa có key.
OPENAI_API_KEY=
# Mặc định của ứng dụng là true: thiếu OPENAI_API_KEY thì app không khởi động. Khi chạy thử ở máy cá nhân mà chưa có key,
# bỏ dấu # ở dòng dưới (khi đó chỉ dùng danh sách từ cấm). Môi trường triển khai thật phải đặt OPENAI_API_KEY và giữ dòng này ở dạng chú thích.
# MODERATION_REQUIRED=false
# DB Supabase dùng chung đã áp migration V12–V16 của nhánh feature chưa merge vào repo (KNOWN-GAPS #26).
# Chạy backend ở máy cá nhân với DB đó thì bỏ dấu # ở dòng dưới; DB mới/CI không cần.
# FLYWAY_IGNORE_MIGRATION_PATTERNS=*:missing,*:future
# Tài khoản quản trị viên đầu tiên (FR-13). Không có mật khẩu mặc định: để trống thì không tạo admin.
# Profile prod bắt buộc APP_ADMIN_PASSWORD (thiếu thì dừng khởi động). Đặt chuỗi dài, ngẫu nhiên, không commit.
APP_ADMIN_EMAIL=admin@aigame.local
APP_ADMIN_PASSWORD=
# Swagger UI tại /swagger-ui.html (mặc định bật). Môi trường triển khai thật đặt false.
# SWAGGER_ENABLED=true
# Gemini spike: supply these in the environment when running the standalone runner.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_MIN_SCORE=0.855
CURRICULUM_PDF=
GEMINI_GAME_GENERATION_ENABLED=false
# Thử nghiệm: kiểm tra hình gắn vào có khớp chữ mô tả không (Layer 2); mặc định tắt
ASSET_MEANING_CHECK_ENABLED=false
# Thử nghiệm: đưa hình liên quan tới yêu cầu lên đầu danh mục hình trong prompt; mặc định tắt
ASSET_SHORTLIST_ENABLED=false
# Gán hình riêng sau Gemini (bước tách bạch thay vì AI tự chọn hình); mặc định tắt
ASSET_BINDER_ENABLED=false
ASSET_BINDER_MODE=fill-empty
ASSET_STYLE_LOCK_ENABLED=true
ASSET_STYLE_LOCK_MIN_COVERAGE=0.5
# Rà chính tả bằng AI sau khi sinh game (thêm tới 2 lần gọi Gemini mỗi game).
WORDING_REVIEW_ENABLED=false
CURRICULUM_RAG_ENABLED=false
CURRICULUM_RAG_MIN_SCORE=0.855

# FR-11 Viettel AI TTS token. Keep it server-side; never commit a real token.
VIETTEL_TTS_TOKEN=<VIETTEL_TTS_TOKEN>
# English narration uses ElevenLabs Flash 2.5. Keep these server-side; never commit real credentials.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CONNECT_TIMEOUT_SECONDS=5
ELEVENLABS_READ_TIMEOUT_SECONDS=25
# Supabase Storage bucket must be private. Use the server-side service-role key only in backend config.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVER_ONLY_SERVICE_ROLE_KEY>
TTS_STORAGE_BUCKET=game-narration
# Bump this value only when changing the fixed correct/wrong narration phrases.
TTS_FEEDBACK_CACHE_VERSION=1

# Local-only Curriculum RAG run (loopback PostgreSQL). Keep disabled in shared environments.
# Uncomment and supply the local role/password only when running against the existing local database.
# DB_URL=jdbc:postgresql://127.0.0.1:55432/rag_eval
# DB_USERNAME=<LOCAL_POSTGRES_ROLE>
# DB_PASSWORD=<LOCAL_POSTGRES_PASSWORD>
# CURRICULUM_RAG_ENABLED=true
# GEMINI_GAME_GENERATION_ENABLED=true
# CURRICULUM_CONSTRAINTS_APPROVED_SHA256=b44066d375f2f591800ded3c0fceaf89ef8c1a4992f9bac5e6e28396a19f189a
