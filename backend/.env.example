# Supabase PostgreSQL connection (Session Pooler or Direct Connection — NOT the Transaction Pooler / port 6543)
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USERNAME=<SUPABASE_DB_USERNAME>
DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# JWT signing key (at least 32 random characters). Generate one, never commit the real value.
JWT_SECRET=<RANDOM_STRING_AT_LEAST_32_CHARS>
# Set false only if your browser rejects Secure cookies on http://localhost.
COOKIE_SECURE=true
# OpenAI Moderation (Layer 3 kiểm duyệt an toàn). Để trống (không điền giá trị mẫu) nếu chưa có key.
OPENAI_API_KEY=
# Mặc định của ứng dụng là true: thiếu OPENAI_API_KEY thì app không khởi động. Khi chạy thử ở máy cá nhân mà chưa có key,
# bỏ dấu # ở dòng dưới (khi đó chỉ dùng danh sách từ cấm). Môi trường triển khai thật phải đặt OPENAI_API_KEY và giữ dòng này ở dạng chú thích.
# MODERATION_REQUIRED=false
# Swagger UI tại /swagger-ui.html (mặc định bật). Môi trường triển khai thật đặt false.
# SWAGGER_ENABLED=true
# Gemini spike: supply these in the environment when running the standalone runner.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=<GEMINI_MODEL>
