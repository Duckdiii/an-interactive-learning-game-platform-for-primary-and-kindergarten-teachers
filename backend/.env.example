# Supabase PostgreSQL connection (Session Pooler or Direct Connection — NOT the Transaction Pooler / port 6543)
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USERNAME=<SUPABASE_DB_USERNAME>
DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# OpenAI Moderation (Layer 3 kiểm duyệt an toàn). Để trống thì chỉ dùng danh sách từ cấm.
OPENAI_API_KEY=<OPENAI_API_KEY>
# true: từ chối khởi động nếu thiếu OPENAI_API_KEY (dùng khi triển khai).
MODERATION_REQUIRED=false
# Gemini spike: supply these in the environment when running the standalone runner.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=<GEMINI_MODEL>
